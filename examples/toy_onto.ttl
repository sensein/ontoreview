@prefix ex:   <http://example.org/toy/> .
@prefix r:    <http://example.org/ref/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix obo:  <http://purl.obolibrary.org/obo/> .
@prefix oio:  <http://www.geneontology.org/formats/oboInOwl#> .

ex:Process a owl:Class ; rdfs:label "process"@en ;
  skos:definition "Something that happens over time and has participants."@en .
ex:Measurement a owl:Class ; rdfs:label "measurement"@en ;
  obo:IAO_0000115 "An act of determining the value of a quantity."@en .
ex:PHReading a owl:Class ; rdfs:subClassOf ex:Measurement ; rdfs:label "pH reading"@en ;
  rdfs:comment "A soil pH value measured at 20 cm depth with a glass electrode, reported to 0.01 units."@en .
ex:SoilPHReading a owl:Class ; rdfs:subClassOf ex:PHReading ; rdfs:label "soil pH reading"@en .
ex:Sensor a owl:Class ; rdfs:label "sensor"@en ;
  skos:definition "A device that detects a physical property and produces an output signal."@en .
ex:SoilSample a owl:Class ; rdfs:label "soil sample"@en ; oio:hasBroadSynonym "sample" ;
  skos:definition "A sample of topsoil collected for agronomic analysis of a field."@en .
ex:Machine a owl:Class ; rdfs:subClassOf r:Device ; rdfs:label "farm machine"@en .
ex:Tractor a owl:Class ; rdfs:subClassOf ex:Machine ; rdfs:label "tractor"@en .
ex:hasParticipant a owl:ObjectProperty ; rdfs:label "has participant"@en .
