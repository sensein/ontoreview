  "rules": [
    {
      "id": "OB001",
      "title": "Ontology has no title",
      "severity": "warning",
      "description": "Add dcterms:title (or rdfs:label) to the owl:Ontology node."
    },
    {
      "id": "OB002",
      "title": "Ontology has no description",
      "severity": "warning",
      "description": "Add dcterms:description or dcterms:abstract so readers know what the ontology is for."
    },
    {
      "id": "OB003",
      "title": "No license declared",
      "severity": "warning",
      "description": "Declare a license with dcterms:license so others know how they may reuse the ontology."
    },
    {
      "id": "OB004",
      "title": "No version information",
      "severity": "info",
      "description": "Add owl:versionInfo and owl:versionIRI to make releases citable and comparable."
    },
    {
      "id": "OB005",
      "title": "No creators",
      "severity": "warning",
      "description": "Credit the authors with dcterms:creator."
    },
    {
      "id": "OB006",
      "title": "No preferred prefix/namespace",
      "severity": "info",
      "description": "Add vann:preferredNamespacePrefix and vann:preferredNamespaceUri."
    },
    {
      "id": "OB010",
      "title": "Term without a label",
      "severity": "warning",
      "description": "Every term should have a human-readable rdfs:label or skos:prefLabel (OOPS! P08)."
    },
    {
      "id": "OB011",
      "title": "Term without a definition",
      "severity": "warning",
      "description": "Every term should have a definition (skos:definition, IAO:0000115 or rdfs:comment) (OOPS! P08)."
    },
    {
      "id": "OB012",
      "title": "Property without domain",
      "severity": "info",
      "description": "Consider declaring rdfs:domain (OOPS! P11). Ignored when the property is used in class axioms."
    },
    {
      "id": "OB013",
      "title": "Property without range",
      "severity": "info",
      "description": "Consider declaring rdfs:range (OOPS! P11)."
    },
    {
      "id": "OB014",
      "title": "Cycle in class hierarchy",
      "severity": "error",
      "description": "A class is (indirectly) a subclass of itself, which makes the classes equivalent (OOPS! P06)."
    },
    {
      "id": "OB015",
      "title": "Undeclared term",
      "severity": "error",
      "description": "A term in the ontology namespace is used but never declared (no rdf:type) (OOPS! P34/P35)."
    },
    {
      "id": "OB016",
      "title": "Duplicate labels",
      "severity": "warning",
      "description": "Two or more terms share the same label, which confuses readers and tools."
    },
    {
      "id": "OB017",
      "title": "Multiple labels in one language",
      "severity": "warning",
      "description": "A term has more than one rdfs:label/skos:prefLabel in the same language."
    },
    {
      "id": "OB018",
      "title": "Deprecated term without replacement",
      "severity": "info",
      "description": "Deprecated terms should point to their replacement with dcterms:isReplacedBy."
    },
    {
      "id": "OB019",
      "title": "Inconsistent naming convention",
      "severity": "info",
      "description": "Classes are usually UpperCamelCase and properties lowerCamelCase (OOPS! P22)."
    },
    {
      "id": "OB020",
      "title": "Class both subclass of and disjoint with another",
      "severity": "error",
      "description": "A class that is a subclass of a class it is disjoint with is unsatisfiable."
    },
    {
      "id": "OB021",
      "title": "Transitive property used as functional",
