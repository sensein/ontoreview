# Generated by ontoreview. Include in your nginx `http {}` block.
map $http_accept $ontoreview_target {
    default /index.html;
    "~text/turtle" /ontology.ttl;
    "~application/rdf\+xml" /ontology.owl;
    "~application/ld\+json" /ontology.jsonld;
    "~application/n-triples" /ontology.nt;
}

server {
    # ... your listen / server_name directives ...
    location = / {
        return 303 $ontoreview_target;
    }
    location / {
        types {
            text/turtle ttl;
            application/rdf+xml owl rdf;
            application/ld+json jsonld;
            application/n-triples nt;
        }
        try_files $uri $uri/ =404;
    }
}
