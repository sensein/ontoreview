>
  <rdf:Description rdf:about="https://w3id.org/example/personinfo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:title>Person Information Model</dcterms:title>
    <dcterms:description>A LinkML model for people, organizations and their relationships.
Used to test **OntoReview**'s LinkML support.</dcterms:description>
    <owl:versionInfo>0.3.0</owl:versionInfo>
    <dcterms:license rdf:resource="https://creativecommons.org/publicdomain/zero/1.0/"/>
    <dcterms:creator rdf:resource="https://orcid.org/0000-0000-0000-0002"/>
    <dcterms:contributor>Grace Hopper</dcterms:contributor>
    <dcterms:created>2025-02-01</dcterms:created>
    <dcterms:modified>2026-10-15</dcterms:modified>
    <ns2:keywords>people</ns2:keywords>
    <ns2:keywords>organizations</ns2:keywords>
    <ns1:preferredNamespacePrefix>personinfo</ns1:preferredNamespacePrefix>
    <ns1:preferredNamespaceUri>https://w3id.org/example/personinfo/</ns1:preferredNamespaceUri>
    <linkml:generation_source>LinkML schema</linkml:generation_source>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N94efb79661874b829301b95ac3efdb36">
    <rdf:first rdf:nodeID="Ne80d5514b8f04ea88bb00e3a68198116"/>
    <rdf:rest rdf:nodeID="Necc24176d89e4aa6ade2afe23e2d089a"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://schema.org/Person">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Person</rdfs:label>
    <skos:definition>A person (alive, dead, undead, or fictional).</skos:definition>
    <skos:altLabel>human being</skos:altLabel>
    <skos:example>Ada Lovelace — a famous mathematician</skos:example>
    <skos:exactMatch rdf:resource="http://schema.org/Person"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/example/personinfo"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/example/personinfo/NamedThing"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/example/personinfo/HasAliases"/>
    <rdfs:subClassOf rdf:nodeID="Nddb4fdb239be44d28359eaad4b0f527a"/>
    <rdfs:subClassOf rdf:nodeID="N2df3459332644fe3bb5126454777b9a4"/>
    <rdfs:subClassOf rdf:nodeID="N8332b9e751484585934f0fa4140b665d"/>
    <rdfs:subClassOf rdf:nodeID="N05eac45fd31b4c7ca3ee43330f2b1b48"/>
    <rdfs:subClassOf rdf:nodeID="N9fad8436add94487a5e787c9e448713d"/>
    <linkml:mixins rdf:resource="https://w3id.org/example/personinfo/HasAliases"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/example/personinfo/id">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>id</rdfs:label>
    <skos:definition>A unique identifier for a thing.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/example/core"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <linkml:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</linkml:identifier>
    <linkml:domain_of rdf:resource="https://w3id.org/example/personinfo/NamedThing"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/example/personinfo/Organization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Organization</rdfs:label>
    <skos:definition>An organization such as a company or university.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/example/personinfo"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/example/personinfo/NamedThing"/>
    <rdfs:subClassOf rdf:nodeID="N37d42b2e118640f9b5ba796aebe34ef5"/>
    <rdfs:subClassOf rdf:nodeID="Nf5cd9b5454a7403e87574cbef4b7e0da"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne80d5514b8f04ea88bb00e3a68198116">
    <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</xsd:minInclusive>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/example/personinfo/PhoneNumberType">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
    <rdfs:label>PhoneNumberType</rdfs:label>
    <skos:definition>A phone number.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/example/core"/>
    <owl:equivalentClass rdf:nodeID="N4a605e946601434299e1812e083bf3ab"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://schema.org/name">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>name</rdfs:label>
    <skos:definition>A human-readable name for a thing.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/example/core"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <linkml:domain_of rdf:resource="https://w3id.org/example/personinfo/NamedThing"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N9b78d7c3f21940739a54d44561baadc6">
