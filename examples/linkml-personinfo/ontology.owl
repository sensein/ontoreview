    <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N9412e9f87d064a3ca7ae516659dda735">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
