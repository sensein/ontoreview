  <rdf:Description rdf:about="https://w3id.org/example/personinfo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:title>Person Information Model</dcterms:title>
    <dcterms:description>A LinkML model for people, organizations and their relationships.
Used to test **OntoReview**'s LinkML support.</dcterms:description>
    <owl:versionInfo>0.3.0</owl:versionInfo>
    <dcterms:license rdf:resource="https://creativecommons.org/publicdomain/zero/1.0/"/>
    <dcterms:creator rdf:resource="https://orcid.org/0000-0000-0000-0002"/>
    <dcterms:contributor>Grace Hopper</dcterms:contributor>
    <dcterms:created>2025-02-01</dcterms:created>
    <dcterms:modified>2026-10-15</dcterms:modified>
    <ns2:keywords>people</ns2:keywords>
    <ns2:keywords>organizations</ns2:keywords>
    <ns1:preferredNamespacePrefix>personinfo</ns1:preferredNamespacePrefix>
    <ns1:preferredNamespaceUri>https://w3id.org/example/personinfo/</ns1:preferredNamespaceUri>
    <linkml:generation_source>LinkML schema</linkml:generation_source>
  </rdf:Description>
