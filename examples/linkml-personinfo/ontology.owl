  <rdf:Description rdf:about="https://w3id.org/example/personinfo/id">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>id</rdfs:label>
    <skos:definition>A unique identifier for a thing.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/example/core"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <linkml:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</linkml:identifier>
    <linkml:domain_of rdf:resource="https://w3id.org/example/personinfo/NamedThing"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne3ae7e54b61942e995ff65a944f0b396">
    <xsd:pattern>^\S+@[\S+\.]+\S+</xsd:pattern>
  </rdf:Description>
