    <rdfs:range rdf:resource="https://w3id.org/example/personinfo/Organization"/>
    <linkml:multivalued rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</linkml:multivalued>
    <linkml:inlined_as_list rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</linkml:inlined_as_list>
    <linkml:attribute_of rdf:resource="https://w3id.org/example/personinfo/Container"/>
    <linkml:domain_of rdf:resource="https://w3id.org/example/personinfo/Container"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/example/personinfo/GenderType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <linkml:kind>enum</linkml:kind>
    <rdfs:label>GenderType</rdfs:label>
    <skos:definition>Gender of a person.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/example/personinfo"/>
    <owl:equivalentClass rdf:nodeID="N098471d7d27d45b28c83dd31c100a012"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://schema.org/email">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>primary_email</rdfs:label>
    <skos:definition>The main email address of a person.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/example/personinfo"/>
    <rdfs:range rdf:nodeID="Nfe583876202c4bbe93236e391bc50eb6"/>
    <linkml:pattern>^\S+@[\S+\.]+\S+</linkml:pattern>
    <linkml:domain_of rdf:resource="http://schema.org/Person"/>
  </rdf:Description>
