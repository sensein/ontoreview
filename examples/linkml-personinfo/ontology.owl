    <rdfs:range rdf:nodeID="N643f40e68d5c4061a1003442b3dd9625"/>
    <linkml:minimum_value rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</linkml:minimum_value>
    <linkml:maximum_value rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">999</linkml:maximum_value>
    <linkml:domain_of rdf:resource="http://schema.org/Person"/>
  </rdf:Description>
