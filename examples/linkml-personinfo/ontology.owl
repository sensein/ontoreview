  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/example/personinfo/GenderType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <linkml:kind>enum</linkml:kind>
    <rdfs:label>GenderType</rdfs:label>
    <skos:definition>Gender of a person.</skos:definition>
