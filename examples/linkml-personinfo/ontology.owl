  <rdf:Description rdf:about="https://w3id.org/example/personinfo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:title>Person Information Model</dcterms:title>
    <dcterms:description>A LinkML model for people, organizations and their relationships.
Used to test **OntoReview**'s LinkML support.</dcterms:description>
    <owl:versionInfo>0.3.0</owl:versionInfo>
    <dcterms:license rdf:resource="https://creativecommons.org/publicdomain/zero/1.0/"/>
    <dcterms:creator rdf:resource="https://orcid.org/0000-0000-0000-0002"/>
    <dcterms:contributor>Grace Hopper</dcterms:contributor>
    <dcterms:created>2025-02-01</dcterms:created>
    <dcterms:modified>2026-10-15</dcterms:modified>
    <ns2:keywords>people</ns2:keywords>
    <ns2:keywords>organizations</ns2:keywords>
    <ns1:preferredNamespacePrefix>personinfo</ns1:preferredNamespacePrefix>
    <ns1:preferredNamespaceUri>https://w3id.org/example/personinfo/</ns1:preferredNamespaceUri>
    <linkml:generation_source>LinkML schema</linkml:generation_source>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/example/personinfo/id">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>id</rdfs:label>
    <skos:definition>A unique identifier for a thing.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/example/core"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <linkml:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</linkml:identifier>
    <linkml:domain_of rdf:resource="https://w3id.org/example/personinfo/NamedThing"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://schema.org/name">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>name</rdfs:label>
    <skos:definition>A human-readable name for a thing.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/example/core"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <linkml:domain_of rdf:resource="https://w3id.org/example/personinfo/NamedThing"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://schema.org/email">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>primary_email</rdfs:label>
    <skos:definition>The main email address of a person.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/example/personinfo"/>
    <rdfs:range rdf:nodeID="N679d58477bfa4e0d95304076db73b562"/>
    <linkml:pattern>^\S+@[\S+\.]+\S+</linkml:pattern>
    <linkml:domain_of rdf:resource="http://schema.org/Person"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/example/personinfo/Container">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Container</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/example/personinfo"/>
    <linkml:tree_root rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</linkml:tree_root>
    <rdfs:subClassOf rdf:nodeID="Nd3a3e1f8f34341d299cead8133a69aad"/>
    <rdfs:subClassOf rdf:nodeID="Nbb7621af59b6456aaf0795d2a8560c0a"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://schema.org/description">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>description</rdfs:label>
    <skos:definition>A human-readable description for a thing.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/example/core"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <linkml:domain_of rdf:resource="https://w3id.org/example/personinfo/NamedThing"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/example/personinfo/gender">
