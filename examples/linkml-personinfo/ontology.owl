  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/example/personinfo/founding_date">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>founding_date</rdfs:label>
    <skos:definition>When the organization was founded.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/example/personinfo"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <linkml:attribute_of rdf:resource="https://w3id.org/example/personinfo/Organization"/>
