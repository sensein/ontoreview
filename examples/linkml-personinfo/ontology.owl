  <rdf:Description rdf:about="http://schema.org/Person">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Person</rdfs:label>
    <skos:definition>A person (alive, dead, undead, or fictional).</skos:definition>
    <skos:altLabel>human being</skos:altLabel>
    <skos:example>Ada Lovelace — a famous mathematician</skos:example>
    <skos:exactMatch rdf:resource="http://schema.org/Person"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/example/personinfo"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/example/personinfo/NamedThing"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/example/personinfo/HasAliases"/>
    <rdfs:subClassOf rdf:nodeID="N14ca9dc22f1c43f0a6120dd49cc7a09d"/>
    <rdfs:subClassOf rdf:nodeID="Nd3082d9876984a7a94ab93134928b18f"/>
    <rdfs:subClassOf rdf:nodeID="N6c5032fc7b864df2a4acbe00b8a8b50d"/>
    <rdfs:subClassOf rdf:nodeID="N80b0553023174cbca801e715f9f33265"/>
    <rdfs:subClassOf rdf:nodeID="Ncbd65a199c35489b946961e5f734a2c4"/>
    <linkml:mixins rdf:resource="https://w3id.org/example/personinfo/HasAliases"/>
  </rdf:Description>
