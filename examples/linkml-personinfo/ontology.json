   "iri": "http://schema.org/Person",
   "curie": "schema:Person",
   "kind": "class",
   "label": "Person",
   "definition": "A person (alive, dead, undead, or fictional).",
   "synonyms": [
    "human being"
   ],
   "examples": [
    "Ada Lovelace — a famous mathematician"
   ],
   "superclasses": [
    "personinfo:HasAliases",
    "personinfo:NamedThing"
   ],
   "restrictions": [
    "personinfo:gender max 1 personinfo:GenderType",
    "schema:email exactly 1 xsd:string[pattern \"^\\S+@[\\S+\\.]+\\S+\"]",
    "personinfo:age_in_years max 1 xsd:integer[>= 0, <= 999]",
    "personinfo:employed_by max 1 personinfo:Organization",
    "schema:birthDate max 1 xsd:date"
   ]
