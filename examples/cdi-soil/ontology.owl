<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:obo="http://purl.obolibrary.org/obo/"
   xmlns:oio="http://www.geneontology.org/formats/oboInOwl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="http://example.org/toy/Tractor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/toy/Machine"/>
    <rdfs:label xml:lang="en">tractor</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/toy/Sensor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">sensor</rdfs:label>
    <skos:definition xml:lang="en">A device that detects a physical property and produces an output signal.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/toy/SoilSample">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">soil sample</rdfs:label>
    <oio:hasBroadSynonym>sample</oio:hasBroadSynonym>
    <skos:definition xml:lang="en">A sample of topsoil collected for agronomic analysis of a field.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/toy/PHReading">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/toy/Measurement"/>
    <rdfs:label xml:lang="en">pH reading</rdfs:label>
    <rdfs:comment xml:lang="en">A soil pH value measured at 20 cm depth with a glass electrode, reported to 0.01 units.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/toy/Measurement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">measurement</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">An act of determining the value of a quantity.</obo:IAO_0000115>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/toy/SoilPHReading">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/toy/PHReading"/>
    <rdfs:label xml:lang="en">soil pH reading</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/toy/Process">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">process</rdfs:label>
    <skos:definition xml:lang="en">Something that happens over time and has participants.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/toy/Machine">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/ref/Device"/>
    <rdfs:label xml:lang="en">farm machine</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/toy/hasParticipant">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has participant</rdfs:label>
  </rdf:Description>
</rdf:RDF>
