@prefix r:    <http://example.org/ref/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
r:Sensor a owl:Class ; rdfs:label "Sensor" .
r:Sample a owl:Class ; rdfs:label "Sample" .
r:Device a owl:Class ; rdfs:label "Device" .
r:Vehicle a owl:Class ; rdfs:label "vehicle" .
