@prefix : <https://example.org/pizza#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix schema: <https://schema.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

<https://example.org/pizza> a owl:Ontology ;
    dcterms:title "Pizza Ontology"@en , "Ontología de Pizza"@es ;
    dcterms:description "A small ontology about **pizzas** and their toppings, used to test OntoReview."@en ;
    dcterms:abstract "Pizzas, bases and toppings."@en ;
    dcterms:creator <https://orcid.org/0000-0000-0000-0001> , "Jane Doe <jane@example.org>" ;
    dcterms:contributor [ foaf:name "Anonymous Helper" ] ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:created "2024-01-01" ;
    dcterms:modified "2026-11-01" ;
    owl:versionInfo "1.3.0" ;
    owl:versionIRI <https://example.org/pizza/1.2.0> ;
    owl:priorVersion <https://example.org/pizza/1.1.0> ;
    vann:preferredNamespacePrefix "pizza" ;
    vann:preferredNamespaceUri "https://example.org/pizza#" ;
    schema:keywords "food" , "pizza" .

<https://orcid.org/0000-0000-0000-0001> foaf:name "Alice Example" ; schema:affiliation [ schema:name "Example University" ] .

:Food a owl:Class ; rdfs:label "Food"@en , "Comida"@es ;
    skos:definition "Anything that can be eaten."@en , "Cualquier cosa comestible."@es .

:Pizza a owl:Class ; rdfs:subClassOf :Food ;
    rdfs:label "Pizza"@en , "Pizza"@es ;
    skos:definition "A flat **baked** dish topped with ingredients."@en ;
    skos:example "Margherita" ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasBase ; owl:someValuesFrom :PizzaBase ] ,
                    [ a owl:Restriction ; owl:onProperty :hasCalories ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ;
    owl:disjointWith :PizzaTopping .

:VegetarianPizza a owl:Class ; rdfs:label "Vegetarian pizza"@en ;
    skos:definition "A pizza with no meat toppings."@en ;
    owl:equivalentClass [ owl:intersectionOf ( :Pizza [ a owl:Class ; owl:complementOf [ a owl:Restriction ; owl:onProperty :hasTopping ; owl:someValuesFrom :MeatTopping ] ] ) ] .

:PizzaBase a owl:Class ; rdfs:subClassOf :Food ; rdfs:label "Pizza base"@en ;
    skos:definition "The bread base of a pizza."@en .
:PizzaTopping a owl:Class ; rdfs:subClassOf :Food ; rdfs:label "Pizza topping"@en ;
    skos:definition "Something placed on a pizza."@en .
:MeatTopping a owl:Class ; rdfs:subClassOf :PizzaTopping ; rdfs:label "Meat topping"@en .
:CheeseTopping a owl:Class ; rdfs:subClassOf :PizzaTopping ; rdfs:label "Cheese topping"@en ;
    skos:definition "Cheese."@en ; owl:deprecated true .

:hasTopping a owl:ObjectProperty ; rdfs:label "has topping"@en ;
    skos:definition "Relates a pizza to its toppings."@en ;
    rdfs:domain :Pizza ; rdfs:range :PizzaTopping ; owl:inverseOf :isToppingOf .
:isToppingOf a owl:ObjectProperty ; rdfs:label "is topping of"@en .
:hasBase a owl:ObjectProperty , owl:FunctionalProperty ; rdfs:label "has base"@en ;
    rdfs:subPropertyOf :hasIngredient ;
    rdfs:domain :Pizza ; rdfs:range :PizzaBase .
:hasIngredient a owl:ObjectProperty , owl:TransitiveProperty ; rdfs:label "has ingredient"@en ;
    skos:definition "Any ingredient."@en .
:hasCalories a owl:DatatypeProperty ; rdfs:label "has calories"@en ;
    rdfs:domain :Food ;
    rdfs:range [ a rdfs:Datatype ; owl:onDatatype xsd:integer ; owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] .
:Name a owl:DatatypeProperty ; rdfs:label "Pizza"@en ; rdfs:range :PizzaBase .

:Margherita a owl:NamedIndividual , :Pizza ; rdfs:label "Margherita"@en ;
    :hasCalories 800 .

:Calzone a owl:Class ; rdfs:subClassOf :Pizza ; rdfs:label "Calzone"@en ;
    skos:definition "A folded pizza."@en .
